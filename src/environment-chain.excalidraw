      "link": null,
      "locked": false,
      "text": "var number = 1;\n\nfunction printGlobal() {\n    console.log(number);\n}\n\nfunction run(printLinkedToGlobal) {\n    var number = 2;\n    printLinkedToGlobal();\n}\n\nrun(printGlobal);",
