    {
      "id": "nPnfCVKo_nON42aBfAX8V",
      "type": "text",
      "x": 5466.142395630553,
      "y": 235.31770953809746,
      "width": 625,
      "height": 625,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1M",
      "roundness": null,
      "seed": 478426278,
      "version": 463,
      "versionNonce": 2034856186,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1730989279602,
      "link": null,
      "locked": false,
      "text": "var number = 1;\n\nfunction getGlobal() {\n    console.log('global', number);\n    return number;\n}\n\nfunction generateFn() {\n    var number = 2;\n    \n    return function() {\n        var fromGlobal = getGlobal();\n        console.log('inner', number, fromGlobal);\n    }\n}\n\nfunction run(linkedFn) {\n    var number = 3;\n    linkedFn();\n}\n\nvar closure = generateFn();\n\nrun(closure);\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "g4wRIaRjSg-CdhnH9Jfjt",
      "originalText": "var number = 1;\n\nfunction getGlobal() {\n    console.log('global', number);\n    return number;\n}\n\nfunction generateFn() {\n    var number = 2;\n    \n    return function() {\n        var fromGlobal = getGlobal();\n        console.log('inner', number, fromGlobal);\n    }\n}\n\nfunction run(linkedFn) {\n    var number = 3;\n    linkedFn();\n}\n\nvar closure = generateFn();\n\nrun(closure);\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
